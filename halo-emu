    p.add_argument("--wav-in", metavar="FILE",
                   help="feed this 16-bit WAV to the microphone instead of "
                        "silence (looped, resampled to whatever rate the "
                        "firmware asks for); `mic wav <file>` on the "
                        "control socket swaps it at runtime")
    p.add_argument("--audio", nargs="?", const="sdl", metavar="BACKEND",
                   help="live host audio: attaches an -audiodev of this "
                        "type (default sdl; try pa or alsa) for speaker "
                        "playback and microphone capture. Off by default, "
