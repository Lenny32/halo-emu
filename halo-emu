def prepare_mram(args):
    """Create/refresh the MRAM backing file: firmware into slot0, other
    regions preserved (or zeroed with --flash-erase)."""
    try:
        firmware = open(args.firmware, "rb").read()
    except OSError as e:
        die(f"cannot read firmware: {e}")
    if len(firmware) > SLOT_SIZE:
        die(f"firmware is {len(firmware):#x} bytes, exceeds slot0 size "
            f"{SLOT_SIZE:#x}")
    if len(firmware) < 0x1000:
        die(f"firmware is only {len(firmware)} bytes — not a Halo image")

    mcuboot = None
    if args.mcuboot:
        try:
            mcuboot = open(args.mcuboot, "rb").read()
        except OSError as e:
            die(f"cannot read mcuboot: {e}")
        if len(mcuboot) > MCUBOOT_SIZE:
            die(f"mcuboot is {len(mcuboot):#x} bytes, exceeds its "
                f"{MCUBOOT_SIZE:#x} partition")

    created = not os.path.exists(args.flash)
    mode = "w+b" if created else "r+b"
    with open(args.flash, mode) as img:
        img.truncate(MRAM_SIZE)

        img.seek(SLOT0_OFF)
        img.write(firmware)
        img.write(b"\0" * (SLOT_SIZE - len(firmware)))

        if mcuboot is not None:
            img.seek(MCUBOOT_OFF)
            img.write(mcuboot)
            img.write(b"\0" * (MCUBOOT_SIZE - len(mcuboot)))

        if args.flash_erase:
            for off, size in ((SCRATCH_OFF, SCRATCH_SIZE),
                              (STORAGE_OFF, STORAGE_SIZE),
                              (SE_OFF, SE_SIZE)):
                img.seek(off)
                img.write(b"\0" * size)

    action = "created blank" if created else "reusing"
    print(f"halo-emu: {action} {args.flash}; "
          f"{os.path.basename(args.firmware)} "
          f"({len(firmware):#x} bytes) -> slot0"
          + (", non-code regions erased" if args.flash_erase else "")
          + (f", mcuboot -> 0x0" if mcuboot is not None else ""),
          file=sys.stderr)
    return app_vtor_for(firmware)


class Qmp:
    """Minimal QMP client over a unix socket."""

    def __init__(self, path, timeout=10.0):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.settimeout(timeout)
        self.sock.connect(path)
        self.buf = b""
        self._read_msg()  # greeting
        self.command("qmp_capabilities")

    def _read_msg(self):
        while b"\n" not in self.buf:
            chunk = self.sock.recv(4096)
            if not chunk:
                raise ConnectionError("QMP socket closed")
            self.buf += chunk
        line, self.buf = self.buf.split(b"\n", 1)
        return json.loads(line)

    def command(self, name, **arguments):
        msg = {"execute": name}
        if arguments:
            msg["arguments"] = arguments
        self.sock.sendall(json.dumps(msg).encode() + b"\n")
        while True:
            resp = self._read_msg()
            if "return" in resp:
                return resp["return"]
            if "error" in resp:
                raise RuntimeError(f"QMP {name}: {resp['error']['desc']}")
            # asynchronous event — skip


# Discharge curve mV -> SoC % from the firmware's alif_vbat.c (a
# constant-current discharge of a production unit); ascending in both,
# linearly interpolated.  Used to translate `battery set 82%` into the
# raw ADC value the firmware will convert back to ~82%.
DISCHARGE_CURVE = [
    (2920, 0), (3339, 5), (3415, 10), (3484, 15), (3531, 20),
    (3563, 25), (3604, 30), (3630, 35), (3664, 40), (3705, 45),
    (3753, 50), (3796, 55), (3849, 60), (3892, 65), (3939, 70),
    (3995, 75), (4035, 80), (4072, 85), (4095, 90), (4112, 95),
    (4128, 100),
]


def battery_pct_to_mv(pct):
    pct = max(0, min(100, pct))
    for (lo_mv, lo_pct), (hi_mv, hi_pct) in zip(DISCHARGE_CURVE,
                                                DISCHARGE_CURVE[1:]):
        if pct <= hi_pct:
            return lo_mv + (hi_mv - lo_mv) * (pct - lo_pct) \
                // (hi_pct - lo_pct)
    return DISCHARGE_CURVE[-1][0]


def battery_mv_to_pct(mv):
    if mv <= DISCHARGE_CURVE[0][0]:
        return 0
    if mv >= DISCHARGE_CURVE[-1][0]:
        return 100
    for (lo_mv, lo_pct), (hi_mv, hi_pct) in zip(DISCHARGE_CURVE,
                                                DISCHARGE_CURVE[1:]):
        if mv < hi_mv:
            span = hi_mv - lo_mv
            return lo_pct + ((hi_pct - lo_pct) * (mv - lo_mv)
                             + span // 2) // span
    return 100


# The vbat divider (2.4k/1k) against the 1.8 V ADC reference:
# Vbat_mV = raw * 4320 / 4095 (alif_vbat.c, halo_adc.c)
def battery_mv_to_raw(mv):
    return max(0, min(4095, (mv * 4095 + 2160) // 4320))


def battery_raw_to_mv(raw):
    return raw * 4320 // 4095


class CtlServer(threading.Thread):
    """Control socket (ticket 0031): line-oriented text verbs on TCP,
    translated to QMP qom-get/qom-set against the machine's runtime
    control properties (and system_reset for `reboot`).  Timing verbs
    (click, hold) sequence press/release host-side.  One client is
    served at a time; commands within a connection are sequential."""

    CLICK_MS = 150  # inside the 30 ms debounce .. 1000 ms long window

    def __init__(self, qmp_path, listen_port, log=None, bridge=None,
                 cam_dir=None):
        super().__init__(daemon=True, name="halo-ctl")
        self.qmp_path = qmp_path
        self.listen_port = listen_port
        self.log = log or (lambda msg: None)
        self.qmp = None
        # Scratch directory for camera frame containers the `camera`
        # verb builds at runtime (ticket 0033).
        self.cam_dir = cam_dir
        # The REPL bridge, when one is running: the `ase` verbs go to it
        # rather than to QMP, because the LE Audio state machine lives in
        # the ROM stub and is driven over the doorbell (ticket 0038).
        self.bridge = bridge
        self._stop = threading.Event()

    # --- QMP plumbing -----------------------------------------------

    def _qmp(self):
        """The QMP connection, dialled lazily (QEMU may still be
        starting) and re-dialled after errors."""
        if self.qmp is None:
            deadline = time.monotonic() + 15
            while True:
                try:
                    self.qmp = Qmp(self.qmp_path)
                    break
                except OSError:
                    if time.monotonic() >= deadline:
                        raise
                    time.sleep(0.2)
        return self.qmp

    def _cmd(self, name, **arguments):
        try:
            return self._qmp().command(name, **arguments)
        except (OSError, ConnectionError):
            self.qmp = None  # dropped (e.g. QEMU restart): re-dial once
            return self._qmp().command(name, **arguments)

    def _get(self, prop):
        return self._cmd("qom-get", path="/machine", property=prop)

    def _set(self, prop, value):
        self._cmd("qom-set", path="/machine", property=prop, value=value)

    # --- verbs ------------------------------------------------------

    def _verb_button(self, args):
        if args == ["down"]:
            self._set("button-pressed", True)
        elif args == ["up"]:
            self._set("button-pressed", False)
        elif args == ["click"]:
            return self._verb_button(["hold", str(self.CLICK_MS)])
        elif len(args) == 2 and args[0] == "hold":
            ms = int(args[1])
            if not 0 < ms <= 60000:
                return "err hold duration out of range (1..60000 ms)"
            self._set("button-pressed", True)
            time.sleep(ms / 1000.0)
            self._set("button-pressed", False)
        else:
            return "err usage: button down|up|click|hold <ms>"
        return "ok"

    def _verb_battery(self, args):
        if args == ["?"]:
            raw = self._get("battery-raw")
            mv = battery_raw_to_mv(raw)
            return f"ok raw={raw} mv={mv} pct={battery_mv_to_pct(mv)}"
        if len(args) == 2 and args[0] == "set":
            v = args[1].lower()
            if v.endswith("%"):
                raw = battery_mv_to_raw(battery_pct_to_mv(int(v[:-1])))
            elif v.endswith("mv"):
                raw = battery_mv_to_raw(int(v[:-2]))
            else:
                raw = int(v)
            if not 0 <= raw <= 4095:
                return "err raw value out of range (0..4095)"
            self._set("battery-raw", raw)
            mv = battery_raw_to_mv(raw)
            return f"ok raw={raw} mv={mv} pct={battery_mv_to_pct(mv)}"
        return "err usage: battery set <pct%|mV mv|raw> | battery?"

    def _verb_charger(self, args):
        if args == ["?"]:
            conn = int(self._get("charger-connected"))
            en = int(self._get("charge-enabled"))
            return f"ok connected={conn} charge-enabled={en}"
        if args in (["on"], ["off"]):
            self._set("charger-connected", args == ["on"])
            return "ok"
        return "err usage: charger on|off|?"

    def _verb_mic(self, args):
        if args == ["?"]:
            src = self._get("mic-source")
            hz = self._get("mic-tone-hz")
            amp = self._get("mic-tone-amplitude")
            samples = self._get("mic-samples")
            return (f"ok source={src} hz={hz} amp={amp} "
                    f"samples={samples}")
        if args == ["silence"]:
            self._set("mic-wav-in", "")
            self._set("mic-tone-hz", 0)
            return "ok"
        if len(args) == 2 and args[0] == "wav":
            path = os.path.abspath(args[1])
            if not os.path.exists(path):
                return f"err no such file: {path}"
            # A file always wins over the tone; clear it so `mic?`
            # reports the source honestly.
            self._set("mic-tone-hz", 0)
            self._set("mic-wav-in", path)
            return "ok"
        if args and args[0] == "tone" and len(args) in (2, 3):
            hz = int(args[1])
            if not 0 < hz <= 20000:
                return "err tone frequency out of range (1..20000 Hz)"
            amp = int(args[2]) if len(args) == 3 else 8000
            if not 0 <= amp <= 32767:
                return "err amplitude out of range (0..32767)"
            self._set("mic-wav-in", "")
            self._set("mic-tone-amplitude", amp)
            self._set("mic-tone-hz", hz)
            return "ok"
        return "err usage: mic wav <file> | mic tone <hz> [amp] | " \
               "mic silence | mic?"

    # Raw-LSB conversions for the motion sensors (ticket 0037). The
    # machine keeps chip units; these are the scales the firmware
    # programs by default. BMA580: the devicetree's `range = <2>` is
    # 2 g (DT_INST_ENUM_IDX -> BMA5_ACC_RANGE_MAX_2G = 0), which
    # bma580_driver.c scales at 16384 LSB/g — not the 8 g case.
    # QMC6308: 30 G range, qmc6308.c lsb_to_m = 1000. Orientation and
    # heading are ratios, so a scale mismatch would not change them.
    ACCEL_LSB_PER_G = 16384
    MAGN_LSB_PER_GAUSS = 1000

    def _verb_accel(self, args):
        axes = ("accel-x", "accel-y", "accel-z")
        if args == ["?"]:
            raw = [int(self._get(a)) for a in axes]
            mg = [round(r * 1000 / self.ACCEL_LSB_PER_G) for r in raw]
            return (f"ok x={mg[0]} y={mg[1]} z={mg[2]} (mg) "
                    f"raw={raw[0]},{raw[1]},{raw[2]}")
        if len(args) == 3:
            for axis, val in zip(axes, args):
                raw = round(int(val) * self.ACCEL_LSB_PER_G / 1000)
                if not -32768 <= raw <= 32767:
                    return f"err {axis} out of range (max +-8000 mg)"
                self._set(axis, raw)
            return "ok"
        return "err usage: accel <x> <y> <z>  (milli-g) | accel?"

    def _verb_magn(self, args):
        axes = ("magn-x", "magn-y", "magn-z")
        if args == ["?"]:
            raw = [int(self._get(a)) for a in axes]
            mg = [round(r * 1000 / self.MAGN_LSB_PER_GAUSS) for r in raw]
            return (f"ok x={mg[0]} y={mg[1]} z={mg[2]} (mgauss) "
                    f"raw={raw[0]},{raw[1]},{raw[2]}")
        if len(args) == 3:
            for axis, val in zip(axes, args):
                raw = round(int(val) * self.MAGN_LSB_PER_GAUSS / 1000)
                if not -32768 <= raw <= 32767:
                    return f"err {axis} out of range (max +-32767 mgauss)"
                self._set(axis, raw)
            return "ok"
        return "err usage: magn <x> <y> <z>  (milli-gauss) | magn?"

    def _verb_tap(self, args):
        kinds = {"single": 1, "double": 2, "triple": 3}
        if not args:
            args = ["single"]
        if len(args) == 1 and args[0] in kinds:
            self._set("tap", kinds[args[0]])
            return "ok"
        return "err usage: tap [single|double|triple]"

    def _verb_camera(self, args):
        """Camera frame source and readouts (ticket 0033)."""
        if args == ["?"]:
            source = self._get("camera-source")
            return ("ok source=%s frames=%s frame=%s captures=%s "
                    "size=%sx%s streaming=%d triggers=%s"
                    % (source, self._get("camera-frames"),
                       self._get("camera-frame"),
                       self._get("camera-captures"),
                       self._get("camera-width"),
                       self._get("camera-height"),
                       int(self._get("camera-streaming")),
                       self._get("camera-triggers")))
        if len(args) == 1 and args[0] in ("none", "off", "gradient"):
            self._set("camera-file", "")
            return "ok"
        if len(args) == 1:
            if not self.cam_dir:
                return "err no scratch directory for camera frames"
            import camera_source

            out = os.path.join(self.cam_dir, "runtime.cam")
            try:
                w, h, frames = camera_source.build_container(args[0], out)
            except camera_source.CameraSourceError as e:
                return f"err {e}"
            # The model re-reads the file on every set, so reusing the
            # same path is safe.
            self._set("camera-file", out)
            return f"ok {w}x{h} frames={frames}"
        return "err usage: camera <test-pattern|file|none> | camera?"

    def _verb_ase(self, args):
        """Drive the BAP unicast server's ASE state machine (0038)."""
        if self.bridge is None:
            return "err no REPL bridge (LE Audio needs the doorbell)"
        import ble_bridge as bb

        if args and args[0] == "?":
            lids = [int(args[1])] if len(args) == 2 else [0, 1, 2]
            parts = " ".join(
                "ase%d=%s" % (lid, bb.ASE_STATE_NAMES.get(
                    self.bridge.ase_state(lid), "?"))
                for lid in lids)
            return f"ok {parts}"

        if len(args) < 2:
            return ("err usage: ase codec|qos|enable|start|disable|release "
                    "<ase_lid> | ase dp <ase_lid> [off] | ase? [lid]")
        verb, lid = args[0], int(args[1])
        if verb == "codec":
            self.bridge.ase_configure_codec(lid)
        elif verb == "qos":
            self.bridge.ase_configure_qos(lid)
        elif verb == "enable":
            self.bridge.ase_enable(lid)
        elif verb == "start":
            self.bridge.ase_start(lid)
        elif verb == "disable":
            self.bridge.ase_disable(lid)
        elif verb == "release":
            self.bridge.ase_release(lid)
        elif verb == "dp":
            self.bridge.ase_datapath(lid, args[2:] != ["off"])
        else:
            return f"err unknown ase verb: {verb}"
        return "ok"

    def _verb_iso(self, args):
        """Isochronous SDUs (ticket 0039): what the guest has sent, and
        replaying them back into its sink datapath."""
        if self.bridge is None:
            return "err no REPL bridge (LE Audio needs the doorbell)"

        if args and args[0] == "?":
            sdus = self.bridge.iso_captured()
            total = sum(len(s) for s in sdus)
            last = len(sdus[-1]) if sdus else 0
            return f"ok sdus={len(sdus)} bytes={total} last={last}"
        if args == ["clear"]:
            self.bridge.iso_clear()
            return "ok"
        if args and args[0] == "replay":
            sdus = self.bridge.iso_captured()
            if len(args) == 2:
                sdus = sdus[:int(args[1])]
            for seq, sdu in enumerate(sdus):
                self.bridge.iso_send_sdu(sdu, seq=seq)
                # One SDU per interval: the guest posts a single buffer at
                # a time, so bursting would drop all but the first.
                time.sleep(0.01)
            return f"ok replayed={len(sdus)}"
        return "err usage: iso? | iso clear | iso replay [n]"

    def _verb_speaker(self, args):
        en = int(self._get("speaker-enabled"))
        playing = int(self._get("speaker-playing"))
        rate = self._get("speaker-rate")
        samples = self._get("speaker-samples")
        return (f"ok enabled={en} playing={playing} rate={rate} "
                f"samples={samples}")

    def _verb_led(self, args):
        duty = self._get("led-duty")
        period = self._get("led-period")
        on = int(self._get("led-on"))
        return f"ok duty={duty} period={period} on={on}"

    def dispatch(self, line):
        parts = line.split()
        if not parts:
            return None
        verb, args = parts[0], parts[1:]
        # `led?` / `battery?` / `charger?` read naturally without space
        if verb.endswith("?") and len(verb) > 1:
            verb, args = verb[:-1], ["?"] + args
        try:
            if verb == "button":
                return self._verb_button(args)
            if verb == "battery":
                return self._verb_battery(args)
            if verb == "charger":
                return self._verb_charger(args)
            if verb == "led" and args == ["?"]:
                return self._verb_led(args)
            if verb == "speaker" and args == ["?"]:
                return self._verb_speaker(args)
            if verb == "mic":
                return self._verb_mic(args)
            if verb == "accel":
                return self._verb_accel(args)
            if verb in ("magn", "mag"):
                return self._verb_magn(args)
            if verb == "tap":
                return self._verb_tap(args)
            if verb == "camera":
                return self._verb_camera(args)
            if verb == "ase":
                return self._verb_ase(args)
            if verb == "iso":
                return self._verb_iso(args)
            if verb == "reboot" and not args:
                self._cmd("system_reset")
                return "ok"
            if verb == "wdt-fire" and not args:
                self._set("wdt-fire", True)
                return "ok"
            if verb == "ping" and not args:
                return "ok"
            return f"err unknown command: {line.strip()}"
        except ValueError:
            return "err bad number"
        except (OSError, ConnectionError, RuntimeError) as e:
            return f"err {e}"

    # --- server loop ------------------------------------------------

    def _serve_client(self, sock):
        sock.settimeout(1.0)
        buf = b""
        with sock:
            while not self._stop.is_set():
                try:
                    data = sock.recv(4096)
                except socket.timeout:
                    continue
                except OSError:
                    return
                if not data:
                    return
                buf += data
                while b"\n" in buf:
                    line, buf = buf.split(b"\n", 1)
                    reply = self.dispatch(line.decode(errors="replace"))
                    if reply is not None:
                        try:
                            sock.sendall(reply.encode() + b"\n")
                        except OSError:
                            return

    def run(self):
        srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        srv.bind(("127.0.0.1", self.listen_port))
        srv.listen(1)
        srv.settimeout(0.5)
        self.log(f"control socket on tcp://127.0.0.1:{self.listen_port}")
        with srv:
            while not self._stop.is_set():
                try:
                    sock, _ = srv.accept()
                except socket.timeout:
                    continue
                except OSError:
                    return
                self._serve_client(sock)

    def stop(self):
        self._stop.set()


def ppm_to_png(ppm_data, out_path):
    """Convert a binary P6 PPM to an RGB PNG (the QEMU build has no
    libpng, so screendump always produces PPM)."""
    fields = []
    pos = 2  # past "P6"
    while len(fields) < 3:
        while pos < len(ppm_data) and ppm_data[pos:pos + 1].isspace():
            pos += 1
        if ppm_data[pos:pos + 1] == b"#":
            pos = ppm_data.index(b"\n", pos) + 1
            continue
        start = pos
        while not ppm_data[pos:pos + 1].isspace():
            pos += 1
        fields.append(int(ppm_data[start:pos]))
    pos += 1  # single whitespace after maxval
    width, height, maxval = fields
    if maxval != 255:
        die(f"unexpected PPM maxval {maxval}")
    pixels = ppm_data[pos:pos + width * height * 3]

    def chunk(tag, payload):
        return (struct.pack(">I", len(payload)) + tag + payload +
                struct.pack(">I", zlib.crc32(tag + payload)))

    stride = width * 3
    raw = b"".join(b"\x00" + pixels[y * stride:(y + 1) * stride]
                   for y in range(height))
    ihdr = struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0)
    with open(out_path, "wb") as f:
        f.write(b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", ihdr) +
                chunk(b"IDAT", zlib.compress(raw)) + chunk(b"IEND", b""))


def rmtempdir(path):
    """Remove one of the launcher's flat scratch directories."""
    if not path:
        return
    for name in os.listdir(path):
        os.unlink(os.path.join(path, name))
    os.rmdir(path)


_CHILD = None  # the QEMU subprocess, so a signal handler can reap it


def _set_child(proc):
    global _CHILD
    _CHILD = proc


def _reap_child():
    """Terminate the QEMU child if it is still running."""
    global _CHILD
    proc, _CHILD = _CHILD, None
    if proc is None or proc.poll() is not None:
        return
    proc.terminate()
    try:
        proc.wait(timeout=5)
    except subprocess.TimeoutExpired:
        proc.kill()
        proc.wait()


def _signal_child(sig):
    """Forward a signal to QEMU without touching subprocess internals.

    This runs from a signal handler, which executes on the main thread —
    possibly interrupting it inside Popen.wait(). Popen.wait() is not
    reentrant (it holds _waitpid_lock), so calling it here would deadlock
    the launcher and leave QEMU a zombie. Only send the signal; the child
    is reaped by _reap_child() once the stack has unwound.
    """
    proc = _CHILD
    if proc is not None and proc.returncode is None:
        try:
            os.kill(proc.pid, sig)
        except ProcessLookupError:
            pass


def _install_term_handlers():
    """Shut QEMU down on SIGTERM/SIGHUP.

    QEMU runs as a child whenever the REPL bridge or control socket is
    enabled, so the default SIGTERM disposition would kill the launcher
    outright: the cleanup below never runs, QEMU is orphaned (it keeps
    running at full speed, competing for CPU with the next run) and the
    bridge/control temp dirs leak. Raising SystemExit instead unwinds
    through proc.wait() into the finally blocks. SIGINT is deliberately
    left alone — QEMU owns the terminal and gets Ctrl-C directly through
    the foreground process group.
    """
    def handler(signum, frame):
        _signal_child(signal.SIGTERM)
        raise SystemExit(128 + signum)

    for sig in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, handler)


def run_screenshot(cmd, args):
    """Boot under QMP control, screendump after the delay, shut down."""
    qmp_dir = tempfile.mkdtemp(prefix="halo-emu-qmp-")
    qmp_path = os.path.join(qmp_dir, "qmp.sock")
    dump_path = os.path.join(qmp_dir, "frame.ppm")
    cmd += ["-qmp", f"unix:{qmp_path},server=on,wait=off"]

    proc = subprocess.Popen(cmd)
    _set_child(proc)
    try:
        time.sleep(args.screenshot_after)
        if proc.poll() is not None:
            die(f"QEMU exited early with code {proc.returncode}")
        qmp = Qmp(qmp_path)
        qmp.command("screendump", filename=dump_path)
        ppm = open(dump_path, "rb").read()
        if args.screenshot.lower().endswith(".png"):
            ppm_to_png(ppm, args.screenshot)
        else:
            with open(args.screenshot, "wb") as f:
                f.write(ppm)
        print(f"halo-emu: screenshot -> {args.screenshot}", file=sys.stderr)
        qmp.command("quit")
        proc.wait(timeout=10)
    finally:
        if proc.poll() is None:
            proc.kill()
            proc.wait()
        for f in (dump_path, qmp_path):
            if os.path.exists(f):
                os.unlink(f)
        os.rmdir(qmp_dir)


def main():
    args, extra = parse_args()
    _install_term_handlers()
    if not os.access(QEMU, os.X_OK):
        die(f"QEMU binary not found/executable: {QEMU} "
            "(build the fork first — see README.md)")

    app_vtor = prepare_mram(args)

    svtor = MCUBOOT_VTOR if args.mcuboot else app_vtor
    machine = f"halo,mram-file={args.flash},svtor={svtor:#x}"

    # Synthetic BLE/LC3 ROM stub (ticket 0028): loaded into the ROM window
    # so alif_ble_enable() completes and boot reaches the Lua runtime.
    rom_stub = None if args.rom_stub == "none" else args.rom_stub
    if rom_stub:
        if not os.path.exists(rom_stub):
            if args.rom_stub is not DEFAULT_ROM_STUB:
                die(f"ROM stub not found: {rom_stub}")
            print("halo-emu: warning: ROM stub not built "
                  "(make -C rom-stub) — booting without it; main() will "
                  "park in alif_ble_enable()", file=sys.stderr)
            rom_stub = None
    if rom_stub:
        machine += f",rom-file={rom_stub}"
        symfile = os.path.splitext(rom_stub)[0] + ".syms"
        if os.path.exists(symfile):
            machine += f",ble-symfile={symfile}"

    # Audio (ticket 0032): the WAV capture is a machine option; live host
    # playback/capture needs an -audiodev backend the models can open.
    if args.wav_out:
        machine += f",i2s-wav-out={args.wav_out}"
    if args.wav_in:
        if not os.path.exists(args.wav_in):
            die(f"--wav-in file not found: {args.wav_in}")
        machine += f",pdm-wav-in={os.path.abspath(args.wav_in)}"
    if args.audio:
        machine += ",audiodev=halo"

    # Camera (ticket 0033): all image decoding happens here — this QEMU
    # build has neither libpng nor libjpeg — and the model reads the
    # resulting HALOCAM1 container.  The scratch directory also serves
    # the control socket's runtime `camera <src>` verb.
    cam_dir = None
    if args.camera or args.ctl_port:
        cam_dir = tempfile.mkdtemp(prefix="halo-emu-cam-")
    if args.camera:
        sys.path.insert(0, os.path.join(REPO_ROOT, "tools"))
        import camera_source

        interval = int(round(1000.0 / args.camera_fps)) \
            if args.camera_fps > 0 else 0
        out = os.path.join(cam_dir, "boot.cam")
        try:
            width, height, frames = camera_source.build_container(
                args.camera, out, max_frames=args.camera_max_frames,
                interval_ms=interval)
        except camera_source.CameraSourceError as e:
            rmtempdir(cam_dir)
            die(f"--camera: {e}")
        machine += f",cam-file={out}"
        print(f"halo-emu: camera source {args.camera} -> {width}x{height}, "
              f"{frames} frame(s)"
              + (f" at {args.camera_fps:g} fps" if interval else ""),
              file=sys.stderr)

    cmd = [QEMU, "-M", machine, "-serial", "mon:stdio"]
    if args.audio:
        cmd += ["-audiodev", f"{args.audio},id=halo"]
    # -serial index 1 is the halo-ble doorbell chardev (framed GATT
    # transport).  Two modes:
    #   default        - the Lua REPL bridge (ticket 0030) owns the
    #                    doorbell over an internal unix socket and serves
    #                    the REPL wire protocol on tcp://127.0.0.1:9563;
    #   --ble-port N   - raw doorbell framing on TCP for low-level tests
    #                    (tests/smoke_ble.py); the REPL bridge is off.
    bridge = None
    bridge_dir = None
    if rom_stub and args.ble_port:
        cmd += ["-serial",
                f"tcp:127.0.0.1:{args.ble_port},server=on,wait=off"]
        print(f"halo-emu: raw BLE doorbell on "
              f"tcp://127.0.0.1:{args.ble_port} (REPL bridge off)",
              file=sys.stderr)
    elif rom_stub and args.repl_port:
        sys.path.insert(0, os.path.join(REPO_ROOT, "tools"))
        from ble_bridge import ReplBridge
        bridge_dir = tempfile.mkdtemp(prefix="halo-emu-ble-")
        doorbell_path = os.path.join(bridge_dir, "doorbell.sock")
        # wait=on: QEMU blocks until the bridge attaches, so the GATT
        # database dump the ROM stub emits at boot is never lost.
        cmd += ["-serial",
                f"unix:{doorbell_path},server=on,wait=on"]
        bridge = ReplBridge(
            doorbell_path, args.repl_port,
            log=lambda m: print(f"halo-emu: repl-bridge: {m}",
                                file=sys.stderr))
        print(f"halo-emu: Lua REPL bridge on "
              f"tcp://127.0.0.1:{args.repl_port}", file=sys.stderr)
    else:
        cmd += ["-serial", "null"]
    # Control socket (ticket 0031): a QMP monitor on a private unix
    # socket, driven by the CtlServer's text verbs on TCP.
    ctl = None
    ctl_dir = None
    if args.ctl_port:
        ctl_dir = tempfile.mkdtemp(prefix="halo-emu-ctl-")
        cmd += ["-qmp", f"unix:{os.path.join(ctl_dir, 'qmp.sock')},"
                        "server=on,wait=off"]
        ctl = CtlServer(os.path.join(ctl_dir, "qmp.sock"), args.ctl_port,
                        log=lambda m: print(f"halo-emu: {m}",
                                            file=sys.stderr),
                        bridge=bridge, cam_dir=cam_dir)
    # CDC200 display window (ticket 0029): SDL unless --headless.
    cmd += ["-display", "none" if args.headless else "sdl"]
    if args.gdb:
        cmd += ["-s", "-S"]
        print("halo-emu: gdbstub on tcp::1234, CPU halted "
              "(target remote :1234)", file=sys.stderr)
    cmd += extra

    if bridge:
        bridge.start()
    if ctl:
        ctl.start()

    try:
        if args.screenshot:
            run_screenshot(cmd, args)
            return

        # --camera keeps this process resident too: QEMU reads the frame
        # container at startup, so nothing could clean it up after an
        # exec.  (With the default --ctl-port this branch is unreachable
        # anyway.)
        if bridge is None and ctl is None and not args.camera:
            os.execv(QEMU, cmd)

        # The bridge/control server live in this process, so keep it
        # alive alongside QEMU instead of exec'ing over it.
        proc = subprocess.Popen(cmd)
        _set_child(proc)
        while True:
            try:
                sys.exit(proc.wait())
            except KeyboardInterrupt:
                continue  # QEMU owns the terminal; let it shut down
    finally:
        _reap_child()
        if bridge:
            bridge.stop()
        if ctl:
            ctl.stop()
        for d in (bridge_dir, ctl_dir, cam_dir):
            rmtempdir(d)


if __name__ == "__main__":
    main()
