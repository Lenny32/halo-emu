#!/usr/bin/env python3
"""halo-emu — run a real Halo firmware image on the QEMU `halo` machine
(Alif Balletto B1, Cortex-M55 RTSS-HE) with persistent MRAM.

Usage:
    halo-emu -f <firmware.bin|zephyr.signed.bin>
             [--flash <mram.img>] [--flash-erase]
             [--headless] [--gdb]
             [--repl-port 9563] [--ble-port <raw port>]
             [--ctl-port 9562]
             [--wav-out <file>] [--wav-in <file>] [--audio [backend]]
             [--screenshot <png> [--screenshot-after <secs>]]
             [--mcuboot <mcuboot.bin>]
             [-- <extra qemu args>]

The control socket (ticket 0031) serves tcp://127.0.0.1:9562 by default
(--ctl-port, 0 disables): a line-oriented text protocol to drive the
device the way a tester drives hardware.  One command per line, reply
`ok [data]` or `err <reason>`:

    button down|up          hold / release the hardware button
    button click            press for 150 ms (a single click; the
                            firmware reports it ~400 ms after release,
                            once the double-click window expires)
    button hold <ms>        press for <ms> (1000 = Lua long-press;
                            2000 = deep sleep, 5000 = pairing window,
                            15000 = ship mode — hardwired in C)
    battery set <v>         82% | 4000mv | 3698 (raw 0..4095); the
                            firmware polls every 10 s, so allow one
                            poll before frame.battery_* reflects it
    battery?                -> ok raw=.. mv=.. pct=..
    charger on|off          charger STAT (gpio1.3)
    charger?                -> ok connected=0|1 charge-enabled=0|1
                            (charge-enabled = firmware's gpio0.6)
    led?                    -> ok duty=.. period=.. on=0|1
                            (UTIMER3 PWM: brightness = duty/period)
    mic wav <file>          feed a 16-bit WAV to the microphone
                            (looped, resampled to the firmware's rate)
    mic tone <hz> [amp]     synthesise a sine instead (amp 0..32767,
                            default 8000). Use a tone, not DC: the Lua
                            mic path DC-blocks, so a constant level
                            correctly reads back as zeros
    mic silence             back to silence (the default)
    mic?                    -> ok source=wav|tone|host|silence hz=..
                               amp=.. samples=..
    speaker?                -> ok enabled=0|1 playing=0|1 rate=..
                               samples=..  (enabled = MAX98357A
                               SD_MODE on gpio8.5)
    camera <src>|none       set the camera frame source at runtime:
                            test-pattern, a png/pnm/jpeg/mjpeg file, or
                            none for the LPCAM model's built-in gradient.
                            The camera is asleep until Lua calls
                            frame.camera.power_save(false)
    camera?                 -> ok source=file|gradient frames=.. frame=..
                            captures=.. size=WxH streaming=0|1
                            triggers=..  (captures counts DMA'd frames —
                            one Lua capture is 3, LUA_CAMERA_SKIP_FRAMES;
                            triggers counts how often the firmware has
                            started the PAG7982 over I2C, streaming is
                            whether it is running right now)
    accel <x> <y> <z>       set the IMU sample in milli-g, device axes;
                            range is 2 g, so |value| <= 2000. The Lua
                            direction() remaps device->host as up = X,
                            right = -Z, forward = Y, so `accel 1000 0 0`
                            is worn-level (pitch/roll 0) and
                            `accel 0 0 1000` is roll -90. Both sensors
                            are lazy-init: nothing probes them until Lua
                            asks
    accel?                  -> ok x=.. y=.. z=.. (mg) raw=..,..,..
    magn <x> <y> <z>        set the magnetometer in milli-gauss
    magn?                   -> ok x=.. y=.. z=.. (mgauss) raw=..
    tap [single|double|triple]
                            fire an IMU tap on INT1 (gpio3.2), the
                            trigger the Lua imu tap callbacks use
    ase codec|qos|enable|start|disable|release <lid>
                            drive the LE Audio ASE state machine as a
                            central would (ticket 0038): codec -> qos ->
                            enable -> start walks an ASE to streaming.
                            No HCI exists, so this stands in for the ASE
                            Control Point writes; the firmware's own
                            request/confirm callbacks do run
    ase dp <lid> [off]      gate the isochronous datapath (0039 carries
                            the audio itself)
    ase? [lid]              -> ok ase0=idle|codec-configured|...
    iso?                    -> ok sdus=.. bytes=.. last=..  (LC3 SDUs the
                            guest has sent on a source stream)
    iso replay [n]          feed captured SDUs back into the sink
                            datapath, one per 10 ms SDU interval
    iso clear               drop the capture
    reboot                  full machine reset (MRAM/lfs preserved)
    wdt-fire                inject a watchdog timeout: NMI, then a
                            TCM-preserving warm reset 200 ms later
    ping                    liveness check

In the QEMU window the `B` key presses/releases the button.
Interactive use: `nc 127.0.0.1 9562`.

The Lua REPL bridge (ticket 0030) serves tcp://127.0.0.1:9563 by default:
[u8 channel][u16 LE length][payload] frames, channel 0 = Lua RX/TX PDUs
(REPL text / 0x01-marked data / control codes), 1 = audio, 2 = video;
MTU 512, one client at a time, loopback only.  --ble-port N exposes the
raw doorbell framing instead (tests/smoke_ble.py).  Both unsigned
zephyr.bin (vector table at image offset 0) and imgtool-padded images
(offset 0x800) work — the vector offset is auto-detected.

Audio (ticket 0032) is off unless asked for.  --wav-out records
everything the firmware plays into a 16-bit mono WAV (written at a fixed
32 kHz, with the guest's 8/16 kHz clips upsampled into it so one file
holds a whole session correctly timed; the file stays valid on disk
while the emulator runs).  --wav-in feeds the microphone from a WAV
instead of silence.  --audio [backend] attaches a QEMU -audiodev
(default sdl) for live playback and host capture.  The ROM stub carries
a real LC3 codec, so the `encoder='lc3'` speaker and microphone modes
work and interoperate with stock .lc3 bitstreams.

The 256x256 panel (CDC200) shows up as the QEMU SDL window; --headless
(-display none) drops the window but the display model still runs, so
--screenshot works either way: it boots the firmware, waits
--screenshot-after seconds (default 5), captures the current frame via
QMP screendump into the given file (.png, or raw PPM for any other
extension), and shuts the emulator down — the CI path.

The device's 2 MiB MRAM (0x80000000) is backed by a host file
(default ./mram.img, created blank on first use) mapped MAP_SHARED into
the machine, so /lfs — installed main.lua, settings, logs — survives
restarts exactly like the hardware's non-volatile MRAM.

On every launch the -f image is written into the MRAM slot0 window of
the backing file (padding the window's remainder with zeros so a
previously flashed, longer image leaves no stale tail); every other
region is left untouched — mirroring a device that got new firmware
flashed but kept its filesystem.  Both the unsigned zephyr.bin and
zephyr.signed.bin work: the imgtool header occupies the linked 0x800
CONFIG_ROM_START_OFFSET pad, so the load address (0x80020000) and the
vector table (0x80020800) are identical.

MRAM partition map (single source of truth for this repo):

    name         MRAM offset   size       content
    mcuboot      0x000000      0x020000   bootloader (only in --mcuboot mode)
    image-0      0x020000      0x0C3000   application slot0  <- -f goes here
    image-1      0x0E3000      0x0C3000   application slot1 (OTA)
    scratch      0x1A6000      0x002000   mcuboot swap scratch
    storage      0x1A8000      0x020000   littlefs /lfs
    SE-reserved  0x1C8000      0x038000   Secure Enclave region

--flash-erase zeroes the non-code regions (scratch, storage,
SE-reserved) — the factory-reset path; the firmware re-formats /lfs on
the next boot.

--mcuboot <mcuboot.bin> (chain-boot spike): writes the bootloader at
MRAM offset 0 and vectors the CPU from 0x80000000 instead of the app
slot, letting mcuboot verify slot0 and jump to it.  Requires a signed
image in -f.
"""

import argparse
import json
import os
import signal
import socket
import struct
import subprocess
import sys
import tempfile
import threading
import time
import zlib

MRAM_SIZE = 2 * 1024 * 1024

# Partition map (see module docstring)
MCUBOOT_OFF, MCUBOOT_SIZE = 0x000000, 0x020000
SLOT0_OFF, SLOT_SIZE = 0x020000, 0x0C3000
SLOT1_OFF = 0x0E3000
SCRATCH_OFF, SCRATCH_SIZE = 0x1A6000, 0x002000
STORAGE_OFF, STORAGE_SIZE = 0x1A8000, 0x020000
SE_OFF, SE_SIZE = 0x1C8000, 0x038000

MRAM_BASE = 0x80000000
MCUBOOT_VTOR = 0x80000000


def app_vtor_for(firmware):
    """Locate the vector table inside the firmware image: offset 0x800
    for imgtool-padded images (zephyr.signed.bin, or an unsigned build
    with CONFIG_ROM_START_OFFSET=0x800 whose pad the header occupies),
    offset 0 for a plain `west build` app (CONFIG_ROM_START_OFFSET=0).
    A valid Cortex-M vector table starts with an SP in SRAM/DTCM and a
    Thumb reset vector inside MRAM."""
    def plausible(off):
        if len(firmware) < off + 8:
            return False
        sp, rst = struct.unpack_from("<II", firmware, off)
        return ((sp & 0xF0000000) == 0x20000000
                and MRAM_BASE <= rst < MRAM_BASE + MRAM_SIZE
                and (rst & 1))
    for off in (0x800, 0):
        if plausible(off):
            return MRAM_BASE + SLOT0_OFF + off
    die("no vector table found at offset 0 or 0x800 — not a Halo image?")

REPO_ROOT = os.path.dirname(os.path.abspath(__file__))
QEMU = os.path.join(REPO_ROOT, "qemu", "build", "qemu-system-arm")
DEFAULT_ROM_STUB = os.path.join(REPO_ROOT, "rom-stub", "build",
                                "rom-stub-v1_2.bin")


def die(msg):
    print(f"halo-emu: {msg}", file=sys.stderr)
    sys.exit(1)


