#!/usr/bin/env python3
"""halo-emu — run a real Halo firmware image on the QEMU `halo` machine
(Alif Balletto B1, Cortex-M55 RTSS-HE) with persistent MRAM.

Usage:
    halo-emu -f <firmware.bin|zephyr.signed.bin>
             [--flash <mram.img>] [--flash-erase]
             [--headless] [--gdb]
             [--repl-port 9563] [--ble-port <raw port>]
             [--ctl-port 9562]
             [--screenshot <png> [--screenshot-after <secs>]]
             [--mcuboot <mcuboot.bin>]
             [-- <extra qemu args>]

The control socket (ticket 0031) serves tcp://127.0.0.1:9562 by default
(--ctl-port, 0 disables): a line-oriented text protocol to drive the
device the way a tester drives hardware.  One command per line, reply
`ok [data]` or `err <reason>`:

    button down|up          hold / release the hardware button
    button click            press for 150 ms (a single click; the
                            firmware reports it ~400 ms after release,
                            once the double-click window expires)
    button hold <ms>        press for <ms> (1000 = Lua long-press;
                            2000 = deep sleep, 5000 = pairing window,
                            15000 = ship mode — hardwired in C)
    battery set <v>         82% | 4000mv | 3698 (raw 0..4095); the
                            firmware polls every 10 s, so allow one
                            poll before frame.battery_* reflects it
    battery?                -> ok raw=.. mv=.. pct=..
    charger on|off          charger STAT (gpio1.3)
    charger?                -> ok connected=0|1 charge-enabled=0|1
                            (charge-enabled = firmware's gpio0.6)
    led?                    -> ok duty=.. period=.. on=0|1
                            (UTIMER3 PWM: brightness = duty/period)
    reboot                  full machine reset (MRAM/lfs preserved)
    wdt-fire                inject a watchdog timeout: NMI, then a
                            TCM-preserving warm reset 200 ms later
    ping                    liveness check

In the QEMU window the `B` key presses/releases the button.
Interactive use: `nc 127.0.0.1 9562`.

The Lua REPL bridge (ticket 0030) serves tcp://127.0.0.1:9563 by default:
[u8 channel][u16 LE length][payload] frames, channel 0 = Lua RX/TX PDUs
(REPL text / 0x01-marked data / control codes), 1 = audio, 2 = video;
MTU 512, one client at a time, loopback only.  --ble-port N exposes the
raw doorbell framing instead (tests/smoke_ble.py).  Both unsigned
zephyr.bin (vector table at image offset 0) and imgtool-padded images
(offset 0x800) work — the vector offset is auto-detected.

The 256x256 panel (CDC200) shows up as the QEMU SDL window; --headless
(-display none) drops the window but the display model still runs, so
--screenshot works either way: it boots the firmware, waits
--screenshot-after seconds (default 5), captures the current frame via
QMP screendump into the given file (.png, or raw PPM for any other
extension), and shuts the emulator down — the CI path.

The device's 2 MiB MRAM (0x80000000) is backed by a host file
(default ./mram.img, created blank on first use) mapped MAP_SHARED into
the machine, so /lfs — installed main.lua, settings, logs — survives
restarts exactly like the hardware's non-volatile MRAM.

On every launch the -f image is written into the MRAM slot0 window of
the backing file (padding the window's remainder with zeros so a
previously flashed, longer image leaves no stale tail); every other
region is left untouched — mirroring a device that got new firmware
flashed but kept its filesystem.  Both the unsigned zephyr.bin and
zephyr.signed.bin work: the imgtool header occupies the linked 0x800
CONFIG_ROM_START_OFFSET pad, so the load address (0x80020000) and the
vector table (0x80020800) are identical.

MRAM partition map (single source of truth for this repo):

    name         MRAM offset   size       content
    mcuboot      0x000000      0x020000   bootloader (only in --mcuboot mode)
    image-0      0x020000      0x0C3000   application slot0  <- -f goes here
    image-1      0x0E3000      0x0C3000   application slot1 (OTA)
    scratch      0x1A6000      0x002000   mcuboot swap scratch
    storage      0x1A8000      0x020000   littlefs /lfs
    SE-reserved  0x1C8000      0x038000   Secure Enclave region

--flash-erase zeroes the non-code regions (scratch, storage,
SE-reserved) — the factory-reset path; the firmware re-formats /lfs on
the next boot.

--mcuboot <mcuboot.bin> (chain-boot spike): writes the bootloader at
MRAM offset 0 and vectors the CPU from 0x80000000 instead of the app
slot, letting mcuboot verify slot0 and jump to it.  Requires a signed
image in -f.
"""

import argparse
import json
import os
import socket
import struct
import subprocess
import sys
import tempfile
import threading
import time
import zlib

MRAM_SIZE = 2 * 1024 * 1024

# Partition map (see module docstring)
MCUBOOT_OFF, MCUBOOT_SIZE = 0x000000, 0x020000
SLOT0_OFF, SLOT_SIZE = 0x020000, 0x0C3000
SLOT1_OFF = 0x0E3000
SCRATCH_OFF, SCRATCH_SIZE = 0x1A6000, 0x002000
STORAGE_OFF, STORAGE_SIZE = 0x1A8000, 0x020000
SE_OFF, SE_SIZE = 0x1C8000, 0x038000

MRAM_BASE = 0x80000000
MCUBOOT_VTOR = 0x80000000


def app_vtor_for(firmware):
    """Locate the vector table inside the firmware image: offset 0x800
    for imgtool-padded images (zephyr.signed.bin, or an unsigned build
    with CONFIG_ROM_START_OFFSET=0x800 whose pad the header occupies),
    offset 0 for a plain `west build` app (CONFIG_ROM_START_OFFSET=0).
    A valid Cortex-M vector table starts with an SP in SRAM/DTCM and a
    Thumb reset vector inside MRAM."""
    def plausible(off):
        if len(firmware) < off + 8:
            return False
        sp, rst = struct.unpack_from("<II", firmware, off)
        return ((sp & 0xF0000000) == 0x20000000
                and MRAM_BASE <= rst < MRAM_BASE + MRAM_SIZE
                and (rst & 1))
    for off in (0x800, 0):
        if plausible(off):
            return MRAM_BASE + SLOT0_OFF + off
    die("no vector table found at offset 0 or 0x800 — not a Halo image?")

REPO_ROOT = os.path.dirname(os.path.abspath(__file__))
QEMU = os.path.join(REPO_ROOT, "qemu", "build", "qemu-system-arm")
DEFAULT_ROM_STUB = os.path.join(REPO_ROOT, "rom-stub", "build",
                                "rom-stub-v1_2.bin")


def die(msg):
    print(f"halo-emu: {msg}", file=sys.stderr)
    sys.exit(1)


def parse_args():
    argv = sys.argv[1:]
    extra = []
    if "--" in argv:
        i = argv.index("--")
        argv, extra = argv[:i], argv[i + 1:]

    p = argparse.ArgumentParser(
        prog="halo-emu",
        description="Run a Halo firmware image on the QEMU halo machine "
                    "with persistent MRAM.")
    p.add_argument("-f", "--firmware", required=True, metavar="BIN",
                   help="firmware image (zephyr.bin or zephyr.signed.bin)")
    p.add_argument("--flash", default="./mram.img", metavar="IMG",
                   help="MRAM backing file (default ./mram.img, "
                        "created blank)")
    p.add_argument("--flash-erase", action="store_true",
                   help="factory reset: zero the non-code regions "
                        "(scratch, storage, SE-reserved)")
    p.add_argument("--headless", action="store_true",
                   help="run without the UI window (-display none); the "
                        "display model still scans out, so --screenshot "
                        "keeps working")
    p.add_argument("--screenshot", metavar="FILE",
                   help="boot, wait --screenshot-after seconds, capture "
                        "the current frame to FILE (.png, or raw PPM "
                        "otherwise) via QMP screendump, then exit")
    p.add_argument("--screenshot-after", type=float, default=5.0,
                   metavar="SECS",
                   help="seconds to run before --screenshot captures "
                        "(default 5.0 — inside the ~3 s boot-logo hold "
                        "plus boot time)")
    p.add_argument("--gdb", action="store_true",
                   help="start the gdbstub on :1234 and wait (-s -S)")
    p.add_argument("--repl-port", type=int, default=9563, metavar="PORT",
                   help="TCP port of the Lua REPL bridge (default 9563; "
                        "0 disables it). Speaks the native_sim wire "
                        "protocol: [u8 channel][u16 LE length][payload], "
                        "MTU 512, loopback only, one client at a time")
    p.add_argument("--ble-port", type=int, default=0, metavar="PORT",
                   help="expose the raw BLE doorbell framing on this TCP "
                        "port instead of running the REPL bridge "
                        "(0 = off; used by tests/smoke_ble.py)")
    p.add_argument("--ctl-port", type=int, default=9562, metavar="PORT",
                   help="TCP port of the control socket (default 9562; "
                        "0 disables it): button/battery/charger/led/"
                        "reboot/wdt-fire verbs, one text command per "
                        "line — see the module docstring")
    p.add_argument("--rom-stub", metavar="BIN", default=DEFAULT_ROM_STUB,
                   help="synthetic BLE/LC3 ROM stub image (default: "
                        "rom-stub/build/rom-stub-v1_2.bin if built; "
                        "'none' to boot without one — main() then parks "
                        "in alif_ble_enable())")
    p.add_argument("--mcuboot", metavar="BIN",
                   help="chain-boot spike: load this mcuboot at MRAM 0 "
                        "and vector from 0x80000000")
    args = p.parse_args(argv)
    return args, extra


def prepare_mram(args):
    """Create/refresh the MRAM backing file: firmware into slot0, other
    regions preserved (or zeroed with --flash-erase)."""
    try:
        firmware = open(args.firmware, "rb").read()
    except OSError as e:
        die(f"cannot read firmware: {e}")
    if len(firmware) > SLOT_SIZE:
        die(f"firmware is {len(firmware):#x} bytes, exceeds slot0 size "
            f"{SLOT_SIZE:#x}")
    if len(firmware) < 0x1000:
        die(f"firmware is only {len(firmware)} bytes — not a Halo image")

    mcuboot = None
    if args.mcuboot:
        try:
            mcuboot = open(args.mcuboot, "rb").read()
        except OSError as e:
            die(f"cannot read mcuboot: {e}")
        if len(mcuboot) > MCUBOOT_SIZE:
            die(f"mcuboot is {len(mcuboot):#x} bytes, exceeds its "
                f"{MCUBOOT_SIZE:#x} partition")

    created = not os.path.exists(args.flash)
    mode = "w+b" if created else "r+b"
    with open(args.flash, mode) as img:
        img.truncate(MRAM_SIZE)

        img.seek(SLOT0_OFF)
        img.write(firmware)
        img.write(b"\0" * (SLOT_SIZE - len(firmware)))

        if mcuboot is not None:
            img.seek(MCUBOOT_OFF)
            img.write(mcuboot)
            img.write(b"\0" * (MCUBOOT_SIZE - len(mcuboot)))

        if args.flash_erase:
            for off, size in ((SCRATCH_OFF, SCRATCH_SIZE),
                              (STORAGE_OFF, STORAGE_SIZE),
                              (SE_OFF, SE_SIZE)):
                img.seek(off)
                img.write(b"\0" * size)

    action = "created blank" if created else "reusing"
    print(f"halo-emu: {action} {args.flash}; "
          f"{os.path.basename(args.firmware)} "
          f"({len(firmware):#x} bytes) -> slot0"
          + (", non-code regions erased" if args.flash_erase else "")
          + (f", mcuboot -> 0x0" if mcuboot is not None else ""),
          file=sys.stderr)
    return app_vtor_for(firmware)


class Qmp:
    """Minimal QMP client over a unix socket."""

    def __init__(self, path, timeout=10.0):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.settimeout(timeout)
        self.sock.connect(path)
        self.buf = b""
        self._read_msg()  # greeting
        self.command("qmp_capabilities")

    def _read_msg(self):
        while b"\n" not in self.buf:
            chunk = self.sock.recv(4096)
            if not chunk:
                raise ConnectionError("QMP socket closed")
            self.buf += chunk
        line, self.buf = self.buf.split(b"\n", 1)
        return json.loads(line)

    def command(self, name, **arguments):
        msg = {"execute": name}
        if arguments:
            msg["arguments"] = arguments
        self.sock.sendall(json.dumps(msg).encode() + b"\n")
        while True:
            resp = self._read_msg()
            if "return" in resp:
                return resp["return"]
            if "error" in resp:
                raise RuntimeError(f"QMP {name}: {resp['error']['desc']}")
            # asynchronous event — skip


# Discharge curve mV -> SoC % from the firmware's alif_vbat.c (a
# constant-current discharge of a production unit); ascending in both,
# linearly interpolated.  Used to translate `battery set 82%` into the
# raw ADC value the firmware will convert back to ~82%.
DISCHARGE_CURVE = [
    (2920, 0), (3339, 5), (3415, 10), (3484, 15), (3531, 20),
    (3563, 25), (3604, 30), (3630, 35), (3664, 40), (3705, 45),
    (3753, 50), (3796, 55), (3849, 60), (3892, 65), (3939, 70),
    (3995, 75), (4035, 80), (4072, 85), (4095, 90), (4112, 95),
    (4128, 100),
]


def battery_pct_to_mv(pct):
    pct = max(0, min(100, pct))
    for (lo_mv, lo_pct), (hi_mv, hi_pct) in zip(DISCHARGE_CURVE,
                                                DISCHARGE_CURVE[1:]):
        if pct <= hi_pct:
            return lo_mv + (hi_mv - lo_mv) * (pct - lo_pct) \
                // (hi_pct - lo_pct)
    return DISCHARGE_CURVE[-1][0]


def battery_mv_to_pct(mv):
    if mv <= DISCHARGE_CURVE[0][0]:
        return 0
    if mv >= DISCHARGE_CURVE[-1][0]:
        return 100
    for (lo_mv, lo_pct), (hi_mv, hi_pct) in zip(DISCHARGE_CURVE,
                                                DISCHARGE_CURVE[1:]):
        if mv < hi_mv:
            span = hi_mv - lo_mv
            return lo_pct + ((hi_pct - lo_pct) * (mv - lo_mv)
                             + span // 2) // span
    return 100


# The vbat divider (2.4k/1k) against the 1.8 V ADC reference:
# Vbat_mV = raw * 4320 / 4095 (alif_vbat.c, halo_adc.c)
def battery_mv_to_raw(mv):
    return max(0, min(4095, (mv * 4095 + 2160) // 4320))


def battery_raw_to_mv(raw):
    return raw * 4320 // 4095


class CtlServer(threading.Thread):
    """Control socket (ticket 0031): line-oriented text verbs on TCP,
    translated to QMP qom-get/qom-set against the machine's runtime
    control properties (and system_reset for `reboot`).  Timing verbs
    (click, hold) sequence press/release host-side.  One client is
    served at a time; commands within a connection are sequential."""

    CLICK_MS = 150  # inside the 30 ms debounce .. 1000 ms long window

    def __init__(self, qmp_path, listen_port, log=None):
        super().__init__(daemon=True, name="halo-ctl")
        self.qmp_path = qmp_path
        self.listen_port = listen_port
        self.log = log or (lambda msg: None)
        self.qmp = None
        self._stop = threading.Event()

    # --- QMP plumbing -----------------------------------------------

    def _qmp(self):
        """The QMP connection, dialled lazily (QEMU may still be
        starting) and re-dialled after errors."""
        if self.qmp is None:
            deadline = time.monotonic() + 15
            while True:
                try:
                    self.qmp = Qmp(self.qmp_path)
                    break
                except OSError:
                    if time.monotonic() >= deadline:
                        raise
                    time.sleep(0.2)
        return self.qmp

    def _cmd(self, name, **arguments):
        try:
            return self._qmp().command(name, **arguments)
        except (OSError, ConnectionError):
            self.qmp = None  # dropped (e.g. QEMU restart): re-dial once
            return self._qmp().command(name, **arguments)

    def _get(self, prop):
        return self._cmd("qom-get", path="/machine", property=prop)

    def _set(self, prop, value):
        self._cmd("qom-set", path="/machine", property=prop, value=value)

    # --- verbs ------------------------------------------------------

    def _verb_button(self, args):
        if args == ["down"]:
            self._set("button-pressed", True)
        elif args == ["up"]:
            self._set("button-pressed", False)
        elif args == ["click"]:
            return self._verb_button(["hold", str(self.CLICK_MS)])
        elif len(args) == 2 and args[0] == "hold":
            ms = int(args[1])
            if not 0 < ms <= 60000:
                return "err hold duration out of range (1..60000 ms)"
            self._set("button-pressed", True)
            time.sleep(ms / 1000.0)
            self._set("button-pressed", False)
        else:
            return "err usage: button down|up|click|hold <ms>"
        return "ok"

    def _verb_battery(self, args):
        if args == ["?"]:
            raw = self._get("battery-raw")
            mv = battery_raw_to_mv(raw)
            return f"ok raw={raw} mv={mv} pct={battery_mv_to_pct(mv)}"
        if len(args) == 2 and args[0] == "set":
            v = args[1].lower()
            if v.endswith("%"):
                raw = battery_mv_to_raw(battery_pct_to_mv(int(v[:-1])))
            elif v.endswith("mv"):
                raw = battery_mv_to_raw(int(v[:-2]))
            else:
                raw = int(v)
            if not 0 <= raw <= 4095:
                return "err raw value out of range (0..4095)"
            self._set("battery-raw", raw)
            mv = battery_raw_to_mv(raw)
            return f"ok raw={raw} mv={mv} pct={battery_mv_to_pct(mv)}"
        return "err usage: battery set <pct%|mV mv|raw> | battery?"

    def _verb_charger(self, args):
        if args == ["?"]:
            conn = int(self._get("charger-connected"))
            en = int(self._get("charge-enabled"))
            return f"ok connected={conn} charge-enabled={en}"
        if args in (["on"], ["off"]):
            self._set("charger-connected", args == ["on"])
            return "ok"
        return "err usage: charger on|off|?"

    def _verb_led(self, args):
        duty = self._get("led-duty")
        period = self._get("led-period")
        on = int(self._get("led-on"))
        return f"ok duty={duty} period={period} on={on}"

    def dispatch(self, line):
        parts = line.split()
        if not parts:
            return None
        verb, args = parts[0], parts[1:]
        # `led?` / `battery?` / `charger?` read naturally without space
        if verb.endswith("?") and len(verb) > 1:
            verb, args = verb[:-1], ["?"] + args
        try:
            if verb == "button":
                return self._verb_button(args)
            if verb == "battery":
                return self._verb_battery(args)
            if verb == "charger":
                return self._verb_charger(args)
            if verb == "led" and args == ["?"]:
                return self._verb_led(args)
            if verb == "reboot" and not args:
                self._cmd("system_reset")
                return "ok"
            if verb == "wdt-fire" and not args:
                self._set("wdt-fire", True)
                return "ok"
            if verb == "ping" and not args:
                return "ok"
            return f"err unknown command: {line.strip()}"
        except ValueError:
            return "err bad number"
        except (OSError, ConnectionError, RuntimeError) as e:
            return f"err {e}"

    # --- server loop ------------------------------------------------

    def _serve_client(self, sock):
        sock.settimeout(1.0)
        buf = b""
        with sock:
            while not self._stop.is_set():
                try:
                    data = sock.recv(4096)
                except socket.timeout:
                    continue
                except OSError:
                    return
                if not data:
                    return
                buf += data
                while b"\n" in buf:
                    line, buf = buf.split(b"\n", 1)
                    reply = self.dispatch(line.decode(errors="replace"))
                    if reply is not None:
                        try:
                            sock.sendall(reply.encode() + b"\n")
                        except OSError:
                            return

    def run(self):
        srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        srv.bind(("127.0.0.1", self.listen_port))
        srv.listen(1)
        srv.settimeout(0.5)
        self.log(f"control socket on tcp://127.0.0.1:{self.listen_port}")
        with srv:
            while not self._stop.is_set():
                try:
                    sock, _ = srv.accept()
                except socket.timeout:
                    continue
                except OSError:
                    return
                self._serve_client(sock)

    def stop(self):
        self._stop.set()


def ppm_to_png(ppm_data, out_path):
    """Convert a binary P6 PPM to an RGB PNG (the QEMU build has no
    libpng, so screendump always produces PPM)."""
    fields = []
    pos = 2  # past "P6"
    while len(fields) < 3:
        while pos < len(ppm_data) and ppm_data[pos:pos + 1].isspace():
            pos += 1
        if ppm_data[pos:pos + 1] == b"#":
            pos = ppm_data.index(b"\n", pos) + 1
            continue
        start = pos
        while not ppm_data[pos:pos + 1].isspace():
            pos += 1
        fields.append(int(ppm_data[start:pos]))
    pos += 1  # single whitespace after maxval
    width, height, maxval = fields
    if maxval != 255:
        die(f"unexpected PPM maxval {maxval}")
    pixels = ppm_data[pos:pos + width * height * 3]

    def chunk(tag, payload):
        return (struct.pack(">I", len(payload)) + tag + payload +
                struct.pack(">I", zlib.crc32(tag + payload)))

    stride = width * 3
    raw = b"".join(b"\x00" + pixels[y * stride:(y + 1) * stride]
                   for y in range(height))
    ihdr = struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0)
    with open(out_path, "wb") as f:
        f.write(b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", ihdr) +
                chunk(b"IDAT", zlib.compress(raw)) + chunk(b"IEND", b""))


def run_screenshot(cmd, args):
    """Boot under QMP control, screendump after the delay, shut down."""
    qmp_dir = tempfile.mkdtemp(prefix="halo-emu-qmp-")
    qmp_path = os.path.join(qmp_dir, "qmp.sock")
    dump_path = os.path.join(qmp_dir, "frame.ppm")
    cmd += ["-qmp", f"unix:{qmp_path},server=on,wait=off"]

    proc = subprocess.Popen(cmd)
    try:
        time.sleep(args.screenshot_after)
        if proc.poll() is not None:
            die(f"QEMU exited early with code {proc.returncode}")
        qmp = Qmp(qmp_path)
        qmp.command("screendump", filename=dump_path)
        ppm = open(dump_path, "rb").read()
        if args.screenshot.lower().endswith(".png"):
            ppm_to_png(ppm, args.screenshot)
        else:
            with open(args.screenshot, "wb") as f:
                f.write(ppm)
        print(f"halo-emu: screenshot -> {args.screenshot}", file=sys.stderr)
        qmp.command("quit")
        proc.wait(timeout=10)
    finally:
        if proc.poll() is None:
            proc.kill()
            proc.wait()
        for f in (dump_path, qmp_path):
            if os.path.exists(f):
                os.unlink(f)
        os.rmdir(qmp_dir)


def main():
    args, extra = parse_args()
    if not os.access(QEMU, os.X_OK):
        die(f"QEMU binary not found/executable: {QEMU} "
            "(build the fork first — see README.md)")

    app_vtor = prepare_mram(args)

    svtor = MCUBOOT_VTOR if args.mcuboot else app_vtor
    machine = f"halo,mram-file={args.flash},svtor={svtor:#x}"

    # Synthetic BLE/LC3 ROM stub (ticket 0028): loaded into the ROM window
    # so alif_ble_enable() completes and boot reaches the Lua runtime.
    rom_stub = None if args.rom_stub == "none" else args.rom_stub
    if rom_stub:
        if not os.path.exists(rom_stub):
            if args.rom_stub is not DEFAULT_ROM_STUB:
                die(f"ROM stub not found: {rom_stub}")
            print("halo-emu: warning: ROM stub not built "
                  "(make -C rom-stub) — booting without it; main() will "
                  "park in alif_ble_enable()", file=sys.stderr)
            rom_stub = None
    if rom_stub:
        machine += f",rom-file={rom_stub}"
        symfile = os.path.splitext(rom_stub)[0] + ".syms"
        if os.path.exists(symfile):
            machine += f",ble-symfile={symfile}"

    cmd = [QEMU, "-M", machine, "-serial", "mon:stdio"]
    # -serial index 1 is the halo-ble doorbell chardev (framed GATT
    # transport).  Two modes:
    #   default        - the Lua REPL bridge (ticket 0030) owns the
    #                    doorbell over an internal unix socket and serves
    #                    the REPL wire protocol on tcp://127.0.0.1:9563;
    #   --ble-port N   - raw doorbell framing on TCP for low-level tests
    #                    (tests/smoke_ble.py); the REPL bridge is off.
    bridge = None
    bridge_dir = None
    if rom_stub and args.ble_port:
        cmd += ["-serial",
                f"tcp:127.0.0.1:{args.ble_port},server=on,wait=off"]
        print(f"halo-emu: raw BLE doorbell on "
              f"tcp://127.0.0.1:{args.ble_port} (REPL bridge off)",
              file=sys.stderr)
    elif rom_stub and args.repl_port:
        sys.path.insert(0, os.path.join(REPO_ROOT, "tools"))
        from ble_bridge import ReplBridge
        bridge_dir = tempfile.mkdtemp(prefix="halo-emu-ble-")
        doorbell_path = os.path.join(bridge_dir, "doorbell.sock")
        # wait=on: QEMU blocks until the bridge attaches, so the GATT
        # database dump the ROM stub emits at boot is never lost.
        cmd += ["-serial",
                f"unix:{doorbell_path},server=on,wait=on"]
        bridge = ReplBridge(
            doorbell_path, args.repl_port,
            log=lambda m: print(f"halo-emu: repl-bridge: {m}",
                                file=sys.stderr))
        print(f"halo-emu: Lua REPL bridge on "
              f"tcp://127.0.0.1:{args.repl_port}", file=sys.stderr)
    else:
        cmd += ["-serial", "null"]
    # Control socket (ticket 0031): a QMP monitor on a private unix
    # socket, driven by the CtlServer's text verbs on TCP.
    ctl = None
    ctl_dir = None
    if args.ctl_port:
        ctl_dir = tempfile.mkdtemp(prefix="halo-emu-ctl-")
        cmd += ["-qmp", f"unix:{os.path.join(ctl_dir, 'qmp.sock')},"
                        "server=on,wait=off"]
        ctl = CtlServer(os.path.join(ctl_dir, "qmp.sock"), args.ctl_port,
                        log=lambda m: print(f"halo-emu: {m}",
                                            file=sys.stderr))
    # CDC200 display window (ticket 0029): SDL unless --headless.
    cmd += ["-display", "none" if args.headless else "sdl"]
    if args.gdb:
        cmd += ["-s", "-S"]
        print("halo-emu: gdbstub on tcp::1234, CPU halted "
              "(target remote :1234)", file=sys.stderr)
    cmd += extra

    if bridge:
        bridge.start()
    if ctl:
        ctl.start()

    try:
        if args.screenshot:
            run_screenshot(cmd, args)
            return

        if bridge is None and ctl is None:
            os.execv(QEMU, cmd)

        # The bridge/control server live in this process, so keep it
        # alive alongside QEMU instead of exec'ing over it.
        proc = subprocess.Popen(cmd)
        while True:
            try:
                sys.exit(proc.wait())
            except KeyboardInterrupt:
                continue  # QEMU owns the terminal; let it shut down
    finally:
        if bridge:
            bridge.stop()
        if ctl:
            ctl.stop()
        for d in (bridge_dir, ctl_dir):
            if d:
                for f in os.listdir(d):
                    os.unlink(os.path.join(d, f))
                os.rmdir(d)


if __name__ == "__main__":
    main()
