    argv = sys.argv[1:]
    extra = []
    if "--" in argv:
        i = argv.index("--")
        argv, extra = argv[:i], argv[i + 1:]

    p = argparse.ArgumentParser(
        prog="halo-emu",
        description="Run a Halo firmware image on the QEMU halo machine "
                    "with persistent MRAM.")
    p.add_argument("-f", "--firmware", required=True, metavar="BIN",
                   help="firmware image (zephyr.bin or zephyr.signed.bin)")
    p.add_argument("--flash", default="./mram.img", metavar="IMG",
                   help="MRAM backing file (default ./mram.img, "
                        "created blank)")
    p.add_argument("--flash-erase", action="store_true",
                   help="factory reset: zero the non-code regions "
                        "(scratch, storage, SE-reserved)")
    p.add_argument("--headless", action="store_true",
                   help="run without the UI window (-display none); the "
                        "display model still scans out, so --screenshot "
                        "keeps working")
    p.add_argument("--screenshot", metavar="FILE",
                   help="boot, wait --screenshot-after seconds, capture "
                        "the current frame to FILE (.png, or raw PPM "
                        "otherwise) via QMP screendump, then exit")
    p.add_argument("--screenshot-after", type=float, default=5.0,
                   metavar="SECS",
                   help="seconds to run before --screenshot captures "
                        "(default 5.0 — inside the ~3 s boot-logo hold "
                        "plus boot time)")
    p.add_argument("--gdb", action="store_true",
                   help="start the gdbstub on :1234 and wait (-s -S)")
    p.add_argument("--repl-port", type=int, default=9563, metavar="PORT",
                   help="TCP port of the Lua REPL bridge (default 9563; "
                        "0 disables it). Speaks the native_sim wire "
                        "protocol: [u8 channel][u16 LE length][payload], "
                        "MTU 512, loopback only, one client at a time")
    p.add_argument("--ble-port", type=int, default=0, metavar="PORT",
                   help="expose the raw BLE doorbell framing on this TCP "
                        "port instead of running the REPL bridge "
                        "(0 = off; used by tests/smoke_ble.py)")
    p.add_argument("--ctl-port", type=int, default=9562, metavar="PORT",
